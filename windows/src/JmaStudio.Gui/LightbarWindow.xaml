<Window x:Class="JmaStudio.Gui.LightbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JmaStudio.Gui"
        mc:Ignorable="d"
        Title="JMA Studio -- Lightbar" Height="900" Width="760"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B0B12" Foreground="#EAEAF2"
        FontFamily="Segoe UI">
    <DockPanel LastChildFill="True">

        <!-- Top bar: Static/Dynamic mode toggle -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Lightbar" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="ModeStaticBtn" Content="Static" Style="{StaticResource BtnAccent}" Click="ModeStaticBtn_Click"/>
                    <Button x:Name="ModeDynamicBtn" Content="Dynamic" Style="{StaticResource BtnGhost}" Click="ModeDynamicBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <Button x:Name="SavePresetBtn" Content="Save current as preset" Style="{StaticResource BtnAccent}" Click="SavePresetBtn_Click"/>
                <Button x:Name="SetDefaultBtn" Content="Set as default" Style="{StaticResource BtnGhost}" Click="SetDefaultBtn_Click"/>
                <TextBlock x:Name="ToastText" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <StackPanel>

                <!-- Zone & Color -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Zone &amp; Color" Style="{StaticResource PanelHeader}"/>

                        <WrapPanel Margin="0,0,0,16">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Zone" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ZoneCombo" Width="150" SelectionChanged="ZoneCombo_SelectionChanged">
                                    <ComboBoxItem Content="Zone 1 -- Left" Tag="1"/>
                                    <ComboBoxItem Content="Zone 2 -- Center" Tag="2"/>
                                    <ComboBoxItem Content="Zone 3 -- Right" Tag="3"/>
                                    <ComboBoxItem Content="All Zones" Tag="all"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,4">
                                    <Run Text="Brightness"/> <Run x:Name="BrightnessLabel" Text="100%"/>
                                </TextBlock>
                                <Slider x:Name="BrightnessSlider" Width="180" Minimum="0" Maximum="100" ValueChanged="BrightnessSlider_ValueChanged"/>
                            </StackPanel>
                        </WrapPanel>

                        <Border Background="#101013" CornerRadius="6" Padding="10" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <local:LightbarIllustration x:Name="Illustration"/>
                        </Border>

                        <StackPanel x:Name="DynamicModeRow" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock Text="One effect, one color, for the whole bar:" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ModeChipsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource BtnGhost}" Margin="0,0,8,8" Click="ModeChip_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="Color" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <local:ColorWheelPicker x:Name="Wheel" Margin="0,0,20,0"/>
                                <Slider x:Name="ValueSlider" Orientation="Vertical" Minimum="0" Maximum="100" Height="180" ValueChanged="ValueSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button x:Name="OffBtn" Content="Off" Style="{StaticResource BtnGhost}" Click="OffBtn_Click" Margin="0,0,10,0"/>
                            <Button x:Name="AddSwatchBtn" Content="+ Save color" Style="{StaticResource BtnGhost}" Click="AddSwatchBtn_Click" Margin="0,0,10,0"/>
                            <ItemsControl x:Name="UserSwatchesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,14,0" HorizontalAlignment="Center">
                                <TextBlock Text="R" FontSize="11" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox x:Name="RInput" Width="52" TextAlignment="Center" Background="#1A1A26" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource PanelBorderBrush}" Padding="6,4" LostFocus="RgbInput_Changed" KeyDown="RgbInput_KeyDown"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0" HorizontalAlignment="Center">
                                <TextBlock Text="G" FontSize="11" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox x:Name="GInput" Width="52" TextAlignment="Center" Background="#1A1A26" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource PanelBorderBrush}" Padding="6,4" LostFocus="RgbInput_Changed" KeyDown="RgbInput_KeyDown"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="B" FontSize="11" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox x:Name="BInput" Width="52" TextAlignment="Center" Background="#1A1A26" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource PanelBorderBrush}" Padding="6,4" LostFocus="RgbInput_Changed" KeyDown="RgbInput_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Presets" Style="{StaticResource PanelHeader}"/>
                        <ItemsControl x:Name="PresetsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardStyle}" Tag="{Binding Name}" MouseLeftButtonUp="PresetCard_Click">
                                        <Grid>
                                            <StackPanel Margin="14,12">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,20,0"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Content="&#x2715;" Style="{StaticResource PresetDeleteButtonStyle}" Click="DeletePreset_Click" Tag="{Binding Name}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Reactive (keyboard -> lightbar) -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Reactive (keyboard -&gt; lightbar)" Style="{StaticResource PanelHeader}"/>
                            <CheckBox x:Name="ReactiveEnabledCheck" Content="Enabled" HorizontalAlignment="Right" Checked="ReactiveOption_Changed" Unchecked="ReactiveOption_Changed"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,16"
                                   Text="Flashes the matching lightbar zone when a key in that keyboard zone is pressed. Zone 4 flashes all three lightbar zones. Uses the static color path -- this won't run at the same time as a Dynamic effect."/>
                        <WrapPanel Margin="0,0,0,16">
                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Background" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <local:ColorSwatchButton x:Name="ReactiveBgSwatch"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Zone 1 flash" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <local:ColorSwatchButton x:Name="ReactiveZ1Swatch"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Zone 2 flash" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <local:ColorSwatchButton x:Name="ReactiveZ2Swatch"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Zone 3 flash" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <local:ColorSwatchButton x:Name="ReactiveZ3Swatch"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Zone 4 (all) flash" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                                <local:ColorSwatchButton x:Name="ReactiveAllSwatch"/>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Capture current keyboard zones" Style="{StaticResource BtnGhost}" Click="CaptureZonesBtn_Click"/>
                            <TextBlock x:Name="CaptureStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
