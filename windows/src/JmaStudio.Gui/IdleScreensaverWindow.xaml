<Window x:Class="JmaStudio.Gui.IdleScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JmaStudio.Gui"
        mc:Ignorable="d"
        Title="JMA Studio -- Idle Screensaver" Height="720" Width="640"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B0B12" Foreground="#EAEAF2"
        FontFamily="Segoe UI">
    <DockPanel LastChildFill="True">

        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Idle Screensaver" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <CheckBox x:Name="EnabledCheck" Content="Enabled" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource BtnAccent}" Click="SaveBtn_Click"/>
                <TextBlock x:Name="ToastText" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <StackPanel>

                <!-- Idle threshold -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Idle Threshold" Style="{StaticResource PanelHeader}"/>
                        <TextBlock Text="How long with no keyboard, mouse, or controller input before the screensaver kicks in." Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <DockPanel>
                            <TextBlock x:Name="ThresholdLabel" Text="5.0 min" Width="70" VerticalAlignment="Center"/>
                            <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="30" ValueChanged="ThresholdSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Keyboard playlist -->
                <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Keyboard Playlist" Style="{StaticResource PanelHeader}"/>
                        <TextBlock Text="Cycles through these presets while idle, in order (or randomly). One entry behaves like a single fixed effect." Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ListBox x:Name="PlaylistList" Height="140" Background="{StaticResource CardBrush}" BorderThickness="0"/>

                        <DockPanel Margin="0,10,0,0">
                            <ComboBox x:Name="AddPresetCombo" Width="220"/>
                            <Button x:Name="AddPresetBtn" Content="Add" Style="{StaticResource BtnGhost}" Click="AddPresetBtn_Click" Margin="8,0,0,0"/>
                            <Button x:Name="RemovePresetBtn" Content="Remove" Style="{StaticResource BtnGhost}" Click="RemovePresetBtn_Click" Margin="8,0,0,0"/>
                            <Button x:Name="MoveUpBtn" Content="&#x2191;" Style="{StaticResource BtnGhost}" Click="MoveUpBtn_Click" Margin="8,0,0,0" Width="36"/>
                            <Button x:Name="MoveDownBtn" Content="&#x2193;" Style="{StaticResource BtnGhost}" Click="MoveDownBtn_Click" Margin="4,0,0,0" Width="36"/>
                        </DockPanel>

                        <DockPanel Margin="0,18,0,0">
                            <TextBlock x:Name="IntervalLabel" Text="30 s" Width="70" VerticalAlignment="Center"/>
                            <Slider x:Name="IntervalSlider" Minimum="5" Maximum="120" ValueChanged="IntervalSlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Text="Seconds between playlist changes" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>

                        <CheckBox x:Name="RandomOrderCheck" Content="Random order" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Lightbar -->
                <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Lightbar" Style="{StaticResource PanelHeader}"/>
                        <TextBlock Text="Fixed for the whole screensaver, no cycling -- pick an existing preset (a solid color, a built-in effect, or off), or leave it untouched." Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ComboBox x:Name="LightbarPresetCombo" Width="260" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
