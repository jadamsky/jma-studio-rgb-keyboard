<Window x:Class="JmaStudio.Gui.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JmaStudio.Gui"
        mc:Ignorable="d"
        Title="JMA Studio -- Diagnostics" Height="900" Width="780"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B0B12" Foreground="#EAEAF2"
        FontFamily="Segoe UI">
    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Diagnostics" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="UptimeText" Text="--" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="RefreshBtn" Content="Refresh now" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshBtn_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <StackPanel>

                <!-- ==== Emergency actions ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Emergency Actions" Style="{StaticResource PanelHeader}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,12"
                                   Text="Each of these launches a separate elevated process and will show its own UAC prompt (🛡). None of them go through this window's own connection to the Service."/>
                        <WrapPanel>
                            <Button x:Name="ReassertBtn" Content="🛡 Re-assert dominance" Style="{StaticResource BtnDanger}" Click="ReassertBtn_Click"
                                    ToolTip="Re-stops+disables AcerLightingService and re-pushes the last known lightbar color. Safe to run any time."/>
                            <Button x:Name="SwitchToPythonBtn" Content="🛡 Switch to Python Version" Style="{StaticResource BtnDanger}" Click="SwitchToPythonBtn_Click"/>
                            <Button x:Name="SwitchToCSharpBtn" Content="🛡 Switch to C# Version" Style="{StaticResource BtnDanger}" Click="SwitchToCSharpBtn_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="StackStatusText" Text="--" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ==== Hardware status tiles ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Hardware Status" Style="{StaticResource PanelHeader}"/>
                        <UniformGrid Columns="3" Rows="1">
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="KbStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                                    <TextBlock Text="Keyboard" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="KbDetailText" Text="--" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LbStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lightbar" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="LbDetailText" Text="--" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CtrlStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                                    <TextBlock Text="Controller" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="CtrlDetailText" Text="--" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ==== Live mini preview ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Live Preview" Style="{StaticResource PanelHeader}"/>
                        <Border x:Name="MiniPreviewHost" Background="#000006" CornerRadius="8" Padding="10" SizeChanged="MiniPreviewHost_SizeChanged">
                            <Canvas x:Name="MiniKeyboardCanvas"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Rectangle x:Name="LbZone1Rect" Width="60" Height="20" Fill="#222" Margin="0,0,6,0" RadiusX="4" RadiusY="4"/>
                            <Rectangle x:Name="LbZone2Rect" Width="60" Height="20" Fill="#222" Margin="0,0,6,0" RadiusX="4" RadiusY="4"/>
                            <Rectangle x:Name="LbZone3Rect" Width="60" Height="20" Fill="#222" RadiusX="4" RadiusY="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==== Performance ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource PanelHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Frames rendered / written" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="FramesText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="HID write latency (min/avg/max)" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock x:Name="HidLatencyText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="WMI commit latency (min/avg/max)" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock x:Name="WmiLatencyText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12" Margin="0,6,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==== Service health ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Service Health" Style="{StaticResource PanelHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="AcerLightingService" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                            <TextBlock x:Name="AcerServiceText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Other lighting software running" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SuspiciousProcessesText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==== Self-tests ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Self-Tests" Style="{StaticResource PanelHeader}"/>
                        <WrapPanel>
                            <Button x:Name="TestKeyboardBtn" Content="Test keyboard" Style="{StaticResource BtnGhost}" Click="TestKeyboardBtn_Click"/>
                            <Button x:Name="TestLightbarBtn" Content="Test lightbar" Style="{StaticResource BtnGhost}" Click="TestLightbarBtn_Click"/>
                            <Button x:Name="ToggleControllerViewerBtn" Content="Test controller (live viewer)" Style="{StaticResource BtnGhost}" Click="ToggleControllerViewerBtn_Click"/>
                            <Button x:Name="RescanBtn" Content="Re-scan hardware" Style="{StaticResource BtnGhost}" Click="RescanBtn_Click"/>
                        </WrapPanel>

                        <Border x:Name="ControllerViewerHost" Visibility="Collapsed" Background="#000006" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="110" Height="110" Background="#141420" CornerRadius="8" Margin="0,0,20,0">
                                        <Canvas x:Name="LeftStickCanvas" Width="110" Height="110">
                                            <Ellipse x:Name="LeftStickDot" Width="14" Height="14" Fill="{StaticResource AccentABrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border Width="110" Height="110" Background="#141420" CornerRadius="8">
                                        <Canvas x:Name="RightStickCanvas" Width="110" Height="110">
                                            <Ellipse x:Name="RightStickDot" Width="14" Height="14" Fill="{StaticResource AccentBBrush}"/>
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                                <WrapPanel x:Name="ControllerButtonsPanel" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock x:Name="ControllerTriggersText" Text="L2: 0%  R2: 0%" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ==== Logs ==== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Logs" Style="{StaticResource PanelHeader}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="OpenLogsFolderBtn" Content="Open logs folder" Style="{StaticResource BtnGhost}" Click="OpenLogsFolderBtn_Click"/>
                                <Button x:Name="CopyReportBtn" Content="Copy diagnostics report" Style="{StaticResource BtnGhost}" Click="CopyReportBtn_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Background="#000006" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                            <ScrollViewer x:Name="LogScrollViewer" Height="180" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" Text="--" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Foreground="{StaticResource SubTextBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ToastText" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
