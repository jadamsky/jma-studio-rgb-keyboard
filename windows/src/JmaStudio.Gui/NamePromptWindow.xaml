<Window x:Class="JmaStudio.Gui.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save preset" Height="160" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#242429" Foreground="#EDEDED" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptLabel" Text="Preset name" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Padding="6" Background="#1A1A1E" Foreground="#EDEDED"
                 BorderBrush="#3A3A42" KeyDown="NameBox_KeyDown"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" Click="Cancel_Click" Background="#33333A" Foreground="White" BorderThickness="0"/>
            <Button Content="Save" Padding="12,6" Click="Save_Click" Background="#5B8CFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
